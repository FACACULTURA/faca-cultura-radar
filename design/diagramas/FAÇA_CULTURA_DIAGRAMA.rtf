        <header className="flex items-center justify-between mb-6">\
          <div className="flex items-center gap-3">\
            <Logo />\
            <div className="text-sm text-gray-600">Estilo: Minimalista \'95 Paleta: Laranja / Roxo / Preto / Cinza \'95 Logo tipogr\'e1fico: f.cult</div>\
          </div>\
        </header>\
\
        <section className="grid grid-cols-1 md:grid-cols-2 gap-6">\
          <div>\
            <h4 className="mb-3 text-sm font-semibold text-gray-700">Card 2 \'97 Compact / Info-dense</h4>\
            <Card2 item=\{sampleEdital\} />\
          </div>\
\
          <div>\
            <h4 className="mb-3 text-sm font-semibold text-gray-700">Card 4 \'97 Minimal / Visual-first</h4>\
            <Card4 item=\{sampleEdital\} />\
          </div>\
