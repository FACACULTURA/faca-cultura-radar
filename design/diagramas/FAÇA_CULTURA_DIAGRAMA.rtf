import React from 'react'\
\
// FA\'c7A_CULTURA \'97 Card mockups\
// Minimal React component using Tailwind classes to preview two card styles (Card2 and Card4)\
// Default export is a small demo component that renders both variations side-by-side.\
// Tailwind is assumed available in the hosting environment (Streamlit Webview / Storybook / local CRA with Tailwind).\
\
const sampleEdital = \{\
  nome: 'Edital Exemplo: Apoio a S\'e9ries Independentes',\
  instituicao: 'Instituto FCult',\
  tipo: 'S\'e9rie;Desenvolvimento',\
  prazo: '2025-12-15',\
  observacoes: 'Fundos grandes;Coprodu\'e7\'e3o',\
  resumo: 'Financiamento para desenvolvimento de s\'e9ries com foco em territ\'f3rios perif\'e9ricos. Valor por projeto at\'e9 R$ 200.000.'\
\}\
\
function Logo() \{\
  return (\
    <div className="flex items-center gap-2">\
      <div className="font-black text-2xl text-orange-600">f.</div>\
      <div className="text-lg font-semibold text-gray-900">cult</div>\
    </div>\
  )\
\}\
\
function Card2(\{ item \}) \{\
  // compact, info-dense, good for lists\
  return (\
    <article className="w-full max-w-md bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">\
      <header className="flex items-start justify-between">\
        <div className="flex items-center gap-3">\
          <Logo />\
          <div>\
            <h3 className="text-sm font-semibold text-gray-900 leading-tight">\{item.nome\}</h3>\
            <div className="text-xs text-gray-500">\{item.instituicao\} \'95 \{item.tipo.split(';')[0]\}</div>\
          </div>\
        </div>\
        <div className="text-xs text-right">\
          <div className="px-2 py-1 rounded-md bg-gray-100 text-gray-700">Prazo</div>\
          <div className="mt-1 text-sm font-medium text-black">\{item.prazo\}</div>\
        </div>\
      </header>\
\
      <p className="mt-3 text-sm text-gray-700 line-clamp-3">\{item.resumo\}</p>\
\
      <footer className="mt-4 flex items-center justify-between">\
        <div className="flex items-center gap-2">\
          <span className="inline-block text-xs px-2 py-1 rounded-full bg-orange-50 text-orange-700">Fundos grandes</span>\
          <span className="inline-block text-xs px-2 py-1 rounded-full bg-purple-50 text-purple-700">Coprodu\'e7\'e3o</span>\
        </div>\
        <button className="text-sm font-semibold px-3 py-1 rounded-md bg-black text-white hover:opacity-90">Ver edital</button>\
      </footer>\
    </article>\
  )\
\}\
\
function Card4(\{ item \}) \{\
  // minimal, visual-first: large typographic title, clear CTA, big deadline badge, more white space\
  return (\
    <article className="w-full max-w-sm bg-white border border-gray-100 rounded-2xl p-6 shadow-md hover:shadow-lg transition-shadow">\
      <div className="flex items-center justify-between">\
        <Logo />\
        <div className="text-right">\
          <div className="text-xs text-gray-500">Prazo</div>\
          <div className="mt-1 inline-block text-sm font-extrabold text-black bg-gradient-to-r from-orange-400 to-purple-600 text-white px-3 py-1 rounded-xl">\{item.prazo\}</div>\
        </div>\
      </div>\
\
      <h2 className="mt-6 text-lg font-extrabold text-gray-900 leading-tight">\{item.nome\}</h2>\
      <p className="mt-3 text-sm text-gray-600">\{item.resumo\}</p>\
\
      <div className="mt-6 flex items-center justify-between">\
        <div className="flex items-center gap-3">\
          <div className="text-xs text-gray-500">\{item.instituicao\}</div>\
          <div className="px-2 py-1 rounded-md text-xs bg-gray-100 text-gray-700">\{item.tipo.split(';')[0]\}</div>\
        </div>\
        <div className="flex items-center gap-2">\
          <button className="text-sm font-semibold px-4 py-2 rounded-lg border border-gray-200 bg-white hover:bg-gray-50">Detalhes</button>\
          <button className="text-sm font-semibold px-4 py-2 rounded-lg bg-gradient-to-r from-orange-500 to-purple-600 text-white">Candidatar</button>\
        </div>\
      </div>\
    </article>\
  )\
\}\
\
export default function CardMockupDemo() \{\
  return (\
    <div className="min-h-screen bg-gray-50 p-8">\
