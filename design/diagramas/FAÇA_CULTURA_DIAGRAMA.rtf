\
        <section className="mt-8">\
          <h4 className="text-sm font-semibold text-gray-700 mb-3">Notas r\'e1pidas</h4>\
          <ul className="list-disc ml-5 text-sm text-gray-600">\
            <li>Tipografia forte e tipogr\'e1fica para o logo: "f.cult" como marca verbal.</li>\
