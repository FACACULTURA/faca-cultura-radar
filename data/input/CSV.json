import json\
import re\
from datetime import datetime\
\
def slug(texto):\
    texto = texto.lower()\
    texto = (\
        texto.replace("\'e1", "a").replace("\'e0", "a").replace("\'e2", "a").replace("\'e3", "a")\
        .replace("\'e9", "e").replace("\'ea", "e")\
        .replace("\'ed", "i")\
        .replace("\'f3", "o").replace("\'f4", "o").replace("\'f5", "o")\
        .replace("\'fa", "u")\
        .replace("\'e7", "c")\
    )\
    texto = re.sub(r"[^a-z0-9]+", "-", texto).strip("-")\
    return texto\
\
saida = []\
\
with open("base_editais.csv", newline="", encoding="utf-8") as f:\
    reader = csv.DictReader(f)\
    for row in reader:\
        titulo = row["nome"].strip()\
        instituicao = row["instituicao"].strip()\
        prazo = row["prazo"].strip() or None\
        tipos = [t.strip() for t in row["tipo"].split(";") if t.strip()]\
        observacoes = [o.strip() for o in row["observacoes"].split(";") if o.strip()]\
\
        item = \{\
            "id": slug(titulo),\
            "titulo": titulo,\
            "descricao": f"Edital da institui\'e7\'e3o \{instituicao\}.",\
            "instituicao": instituicao,\
            "pais": "Brasil",\
            "regiao": "Am\'e9rica do Sul",\
            "tipo": tipos,\
            "prazo": prazo,\
            "link": row["link"].strip(),\
            "valor": None,\
            "idioma": "Portugu\'eas",\
            "elegibilidade": ["Brasil"],\
            "observacoes": observacoes,\
            "fonte": "base_editais.csv",\
            "atualizadoEm": datetime.utcnow().isoformat()\
        \}\
        saida.append(item)\
\
with open("data/editais.json", "w", encoding="utf-8") as f:\
    json.dump(saida, f, ensure_ascii=False, indent=2)}